{
  "name": "junior-boy-boxing",
  "private": true,
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build:backend": "npm --prefix functions run build",
    "test:unit": "npm --prefix functions run test:unit",
    "test:emulators": "npm run build:backend && firebase emulators:exec --project demo-jbb --only firestore,auth,storage \"npm --prefix functions run test:integration\"",
    "emulators": "firebase emulators:start --project demo-jbb --only auth,firestore,functions,storage",
    "seed": "npm --prefix functions run seed"
  },
  "devDependencies": { "firebase-tools": "15.30.2" }
}
