rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function active() { return signedIn() && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive != false); }
    function admin() { return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin']; }
    function image() { return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function video() { return request.resource.size < 80 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|quicktime|webm)'); }
    match /avatars/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && image();
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }
    match /gym/{file=**} {
      allow read: if true;
      allow create, update: if admin() && (image() || video());
      allow delete: if admin();
    }
  }
}
